{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportPilot Map Result",
  "type": "object",
  "properties": {
    "mappings": {
      "type": "array",
      "items": { "$ref": "mapping-evidence.json" }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "auto_mappable": { "type": "boolean" }
  },
  "required": ["mappings", "confidence_score", "auto_mappable"]
}
