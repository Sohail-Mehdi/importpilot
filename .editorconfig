# EditorConfig — ImportPilot monorepo
# https://editorconfig.org
# Enforces consistent whitespace across editors and contributors.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,html,vue,svelte}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.{php}]
indent_size = 4

[*.{py}]
indent_size = 4

[*.{sql}]
indent_size = 2
